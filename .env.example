# Backend origin only (no /api suffix). Run the API on this port; frontend dev runs on http://localhost:5173.
# getBaseUrl() appends /api in both development and production. Do not put /api in this value.
# In development, Vite proxies /api/* to this target without stripping the /api prefix.
VITE_API_URL=http://localhost:3000

# Google Identity Services Web client ID (same value as backend GOOGLE_CLIENT_ID).
# Authorized JavaScript origins must include this app's origin, e.g. http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Optional: override the Origin/Referer sent on proxied dev requests (e.g. Cloudflare tunnel)
# VITE_DEV_PROXY_ORIGIN=http://localhost:5173
